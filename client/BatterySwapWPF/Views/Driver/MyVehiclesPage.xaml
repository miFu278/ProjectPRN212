<UserControl x:Class="BatterySwapWPF.Views.Driver.MyVehiclesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:BatterySwapWPF.ViewModels.Driver"
             Background="{DynamicResource MaterialDesignPaper}">
    
    <UserControl.DataContext>
        <vm:MyVehiclesViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="My Vehicles" 
                      FontSize="28" FontWeight="Bold"
                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Manage your registered vehicles" 
                      FontSize="14" 
                      Foreground="Gray"
                      Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Loading -->
            <StackPanel VerticalAlignment="Center" 
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading vehicles..." 
                          HorizontalAlignment="Center" 
                          Margin="0,10"
                          Foreground="Gray"/>
            </StackPanel>

            <!-- Error -->
            <Border Background="#FFEBEE" 
                   CornerRadius="8"
                   Padding="20"
                   VerticalAlignment="Center"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AlertCircle" 
                                           Width="48" Height="48"
                                           Foreground="#C62828"
                                           HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}" 
                              Foreground="#C62828"
                              TextAlignment="Center"
                              Margin="0,10"/>
                    <Button Content="RETRY" 
                           Command="{Binding LoadVehiclesCommand}"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Vehicles List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
                <ItemsControl ItemsSource="{Binding Vehicles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,15" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0" 
                                           Background="{DynamicResource PrimaryHueLightBrush}"
                                           CornerRadius="8"
                                           Width="60" Height="60"
                                           Margin="0,0,15,0">
                                        <materialDesign:PackIcon Kind="Car" 
                                                               Width="32" Height="32"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LicensePlate}" 
                                                  FontSize="20" FontWeight="Bold"
                                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <TextBlock Margin="0,5,0,0">
                                            <Run Text="{Binding ModelName}" FontWeight="SemiBold"/>
                                            <Run Text=" • " Foreground="Gray"/>
                                            <Run Text="{Binding Brand}" Foreground="Gray"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <materialDesign:PackIcon Kind="Battery" 
                                                                   Width="16" Height="16"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="Gray"/>
                                            <TextBlock Text="{Binding BatteryType}" 
                                                      FontSize="12"
                                                      Foreground="Gray"
                                                      Margin="5,0,0,0"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" 
                                               Orientation="Horizontal"
                                               VerticalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                               ToolTip="View Details">
                                            <materialDesign:PackIcon Kind="Eye"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Visibility="{Binding Vehicles.Count, Converter={StaticResource NullToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="CarOff" 
                                       Width="100" Height="100"
                                       Foreground="LightGray"/>
                <TextBlock Text="No vehicles registered" 
                          FontSize="18"
                          Foreground="Gray"
                          HorizontalAlignment="Center"
                          Margin="0,20"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
