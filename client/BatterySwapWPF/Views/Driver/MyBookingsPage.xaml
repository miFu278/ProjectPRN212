<UserControl x:Class="BatterySwapWPF.Views.Driver.MyBookingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:BatterySwapWPF.ViewModels.Driver"
             Background="{DynamicResource MaterialDesignPaper}">
    
    <UserControl.DataContext>
        <vm:MyBookingsViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="My Bookings" 
                      FontSize="28" FontWeight="Bold"
                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="View your battery swap reservations" 
                      FontSize="14" 
                      Foreground="Gray"
                      Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Loading -->
            <StackPanel VerticalAlignment="Center" 
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading bookings..." 
                          HorizontalAlignment="Center" 
                          Margin="0,10"
                          Foreground="Gray"/>
            </StackPanel>

            <!-- Bookings List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
                <ItemsControl ItemsSource="{Binding Bookings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,15" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header Row -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding VehicleLicense}" 
                                                      FontSize="20" FontWeight="Bold"
                                                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="{Binding VehicleModel}" 
                                                      FontSize="14"
                                                      Foreground="Gray"
                                                      Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" 
                                               Background="{DynamicResource PrimaryHueLightBrush}"
                                               CornerRadius="12"
                                               Padding="12,6">
                                            <TextBlock Text="{Binding Status}" 
                                                      FontSize="12"
                                                      FontWeight="SemiBold"
                                                      Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <!-- Details Row -->
                                    <Grid Grid.Row="1" Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="MapMarker" 
                                                                       Width="16" Height="16"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="Gray"/>
                                                <TextBlock Text="{Binding StationName}" 
                                                          FontSize="13"
                                                          Margin="8,0,0,0"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="Battery" 
                                                                       Width="16" Height="16"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="Gray"/>
                                                <TextBlock Text="{Binding BatteryModelRequested}" 
                                                          FontSize="13"
                                                          Margin="8,0,0,0"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="Clock" 
                                                                       Width="16" Height="16"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="Gray"/>
                                                <TextBlock Text="{Binding BookingTime}" 
                                                          FontSize="13"
                                                          Margin="8,0,0,0"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CalendarRemove" 
                                                                       Width="16" Height="16"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="Gray"/>
                                                <TextBlock Text="{Binding ExpiredDate}" 
                                                          FontSize="13"
                                                          Margin="8,0,0,0"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Visibility="{Binding HasNoBookings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="CalendarBlank" 
                                       Width="100" Height="100"
                                       Foreground="LightGray"/>
                <TextBlock Text="No bookings yet" 
                          FontSize="18"
                          Foreground="Gray"
                          HorizontalAlignment="Center"
                          Margin="0,20"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
