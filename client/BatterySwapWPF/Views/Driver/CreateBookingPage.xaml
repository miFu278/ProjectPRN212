<UserControl x:Class="BatterySwapWPF.Views.Driver.CreateBookingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:BatterySwapWPF.ViewModels.Driver"
             Background="{DynamicResource MaterialDesignPaper}">
    
    <UserControl.DataContext>
        <vm:CreateBookingViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Create Booking" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Book a battery swap slot" FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                
                <!-- Select Vehicle -->
                <TextBlock Text="Select Vehicle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ComboBox ItemsSource="{Binding Vehicles}"
                         SelectedItem="{Binding SelectedVehicle}"
                         DisplayMemberPath="LicensePlate"
                         materialDesign:HintAssist.Hint="Choose your vehicle"
                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                         Margin="0,0,0,20"/>

                <!-- Station Name -->
                <TextBlock Text="Station Name" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ComboBox ItemsSource="{Binding Stations}"
                     SelectedItem="{Binding SelectedStation}"
                     DisplayMemberPath="Name"
                     materialDesign:HintAssist.Hint="Choose a station"
                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                     Margin="0,0,0,20"/>

                <!-- Booking Date and Time -->
                <TextBlock Text="Booking Date and Time" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DatePicker Grid.Column="0"
                               SelectedDate="{Binding BookingDate}"
                               materialDesign:HintAssist.Hint="Date"
                               Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

                    <materialDesign:TimePicker Grid.Column="2"
                                              SelectedTime="{Binding BookingTime}"
                                              materialDesign:HintAssist.Hint="Time"
                                              Style="{StaticResource MaterialDesignOutlinedTimePicker}"/>
                </Grid>

                <!-- Success Message -->
                <Border Background="#E8F5E9" CornerRadius="8" Padding="15" Margin="0,0,0,20"
                       Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="#2E7D32" Width="24" Height="24" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#2E7D32" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Error Message -->
                <Border Background="#FFEBEE" CornerRadius="8" Padding="15" Margin="0,0,0,20"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle" Foreground="#C62828" Width="24" Height="24" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Create Button -->
                <Button Content="CREATE BOOKING"
                       Command="{Binding CreateBookingCommand}"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Height="48"
                       FontSize="15"
                       IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

                <!-- Loading -->
                <ProgressBar IsIndeterminate="True"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,10,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
