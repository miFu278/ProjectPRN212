<Window x:Class="BatterySwapWPF.Views.Driver.DriverMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BatterySwapWPF.Views.Driver"
        Title="Battery Swap - Driver Dashboard" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="Flash" Width="32" Height="32" VerticalAlignment="Center"/>
                    <TextBlock Text="Driver Dashboard" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
                </StackPanel>
                <Button Content="LOGOUT" 
                       Click="Logout_Click"
                       Style="{StaticResource MaterialDesignFlatButton}"
                       Foreground="White"
                       DockPanel.Dock="Right"/>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Main Content with Sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" 
                   Background="{DynamicResource MaterialDesignDivider}"
                   BorderBrush="{DynamicResource MaterialDesignDivider}"
                   BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    
                    <Button x:Name="BtnMyVehicles"
                           Click="BtnMyVehicles_Click"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           HorizontalContentAlignment="Left"
                           Padding="20,15"
                           Height="Auto">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Car" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="My Vehicles" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMyBookings"
                           Click="BtnMyBookings_Click"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           HorizontalContentAlignment="Left"
                           Padding="20,15"
                           Height="Auto">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="My Bookings" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSwapHistory"
                           Click="BtnSwapHistory_Click"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           HorizontalContentAlignment="Left"
                           Padding="20,15"
                           Height="Auto">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="History" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Swap History" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPackageHistory"
                           Click="BtnPackageHistory_Click"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           HorizontalContentAlignment="Left"
                           Padding="20,15"
                           Height="Auto">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Package" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Package History" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Frame x:Name="ContentFrame" 
                  Grid.Column="1" 
                  NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
