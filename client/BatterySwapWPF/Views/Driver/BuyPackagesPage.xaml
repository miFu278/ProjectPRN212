<UserControl x:Class="BatterySwapWPF.Views.Driver.BuyPackagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
             xmlns:conv="clr-namespace:BatterySwapWPF"
             Height="Auto" Width="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             >

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Buy Packages" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
            <TextBlock Text="Choose a battery package and buy via VNPay" Foreground="Gray" Margin="0,5,0,15" />

            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,6,0,10" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />

            <ItemsControl ItemsSource="{Binding Packages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Price, StringFormat=Price: {0:N0}}" FontWeight="Bold" Margin="0,6,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Width="100" Height="36" Content="Buy" Margin="8,0,0,0"
                                    Click="OnBuyClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
