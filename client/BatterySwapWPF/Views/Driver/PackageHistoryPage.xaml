<UserControl x:Class="BatterySwapWPF.Views.Driver.PackageHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:BatterySwapWPF.ViewModels.Driver"
             Background="{DynamicResource MaterialDesignPaper}">
    
    <UserControl.DataContext>
        <vm:PackageHistoryViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Package History" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Your package purchase history" FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading..." HorizontalAlignment="Center" Margin="0,10" Foreground="Gray"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
                <ItemsControl ItemsSource="{Binding PackageHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,15" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource PrimaryHueLightBrush}"
                                           CornerRadius="8" Width="60" Height="60" Margin="0,0,15,0">
                                        <materialDesign:PackIcon Kind="Package" Width="32" Height="32"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PackageName}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TransactionTime}" FontSize="13" Foreground="Gray" Margin="0,5,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <materialDesign:PackIcon Kind="CreditCard" Width="14" Height="14" VerticalAlignment="Center" Foreground="Gray"/>
                                            <TextBlock Text="{Binding PaymentMethod}" FontSize="12" Foreground="Gray" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:N0} VND}" 
                                              FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
