<UserControl x:Class="BatterySwapWPF.Views.Driver.SwapHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:BatterySwapWPF.ViewModels.Driver"
             Background="{DynamicResource MaterialDesignPaper}">
    
    <UserControl.DataContext>
        <vm:SwapHistoryViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Swap History" 
                      FontSize="28" FontWeight="Bold"
                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Your battery swap transactions" 
                      FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center" 
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading history..." HorizontalAlignment="Center" Margin="0,10" Foreground="Gray"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
                <ItemsControl ItemsSource="{Binding SwapHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,15" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource PrimaryHueLightBrush}"
                                           CornerRadius="8" Width="60" Height="60" Margin="0,0,15,0">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="32" Height="32"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StationName}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SwapTime}" FontSize="13" Foreground="Gray" Margin="0,5,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="SoH: " FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding SoH_Old, StringFormat={}{0:F1}%}" FontSize="12" Foreground="Red" FontWeight="SemiBold"/>
                                            <TextBlock Text=" → " FontSize="12" Foreground="Gray" Margin="5,0"/>
                                            <TextBlock Text="{Binding SoH_New, StringFormat={}{0:F1}%}" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Fee, StringFormat={}{0:N0} VND}" FontSize="16" FontWeight="Bold" 
                                                  Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Right"/>
                                        <Border Background="#E8F5E9" CornerRadius="8" Padding="8,4" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
