<UserControl x:Class="BatterySwapWPF.Views.Staff.AllBookingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:BatterySwapWPF.ViewModels.Staff"
             Background="{DynamicResource MaterialDesignPaper}">
    
    <UserControl.DataContext>
        <vm:AllBookingsViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="All Bookings" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="View all customer bookings" FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading bookings..." HorizontalAlignment="Center" Margin="0,10" Foreground="Gray"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
                <ItemsControl ItemsSource="{Binding Bookings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,15" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding UserName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                <TextBlock Text=" • " FontSize="16" Foreground="Gray" Margin="5,0"/>
                                                <TextBlock Text="{Binding VehicleLicense}" FontSize="18" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding VehicleModel}" FontSize="14" Foreground="Gray" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{DynamicResource PrimaryHueLightBrush}"
                                               CornerRadius="12" Padding="12,6">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="MapMarker" Width="16" Height="16" VerticalAlignment="Center" Foreground="Gray"/>
                                                <TextBlock Text="{Binding StationName}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Battery" Width="16" Height="16" VerticalAlignment="Center" Foreground="Gray"/>
                                                <TextBlock Text="{Binding BatteryModelRequested}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="Clock" Width="16" Height="16" VerticalAlignment="Center" Foreground="Gray"/>
                                                <TextBlock Text="{Binding BookingTime}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CalendarRemove" Width="16" Height="16" VerticalAlignment="Center" Foreground="Gray"/>
                                                <TextBlock Text="{Binding ExpiredDate}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding SlotCode}" FontSize="13" Foreground="Gray" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding ChargingStationName}" FontSize="13" Foreground="Gray"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
