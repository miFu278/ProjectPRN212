<Window x:Class="BatterySwapWPF.Views.Admin.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Battery Swap - Admin Dashboard" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="ShieldAccount" Width="32" Height="32" VerticalAlignment="Center"/>
                    <TextBlock Text="Admin Dashboard" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
                </StackPanel>
                <Button Content="LOGOUT" 
                       Click="Logout_Click"
                       Style="{StaticResource MaterialDesignFlatButton}"
                       Foreground="White"
                       DockPanel.Dock="Right"/>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Security" Width="120" Height="120" 
                                        Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="Welcome, Admin!" 
                          FontSize="32" FontWeight="Bold"
                          HorizontalAlignment="Center" Margin="0,20"/>
                <TextBlock Text="System administration and management" 
                          FontSize="18" 
                          HorizontalAlignment="Center"
                          Foreground="Gray"
                          Margin="0,5"/>
                <TextBlock Text="Features coming soon..." 
                          FontSize="14" 
                          HorizontalAlignment="Center"
                          Foreground="LightGray"
                          Margin="0,20"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
