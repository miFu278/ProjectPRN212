<Window x:Class="BatterySwapWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:BatterySwapWPF.ViewModels"
        Title="Battery Swap - Login" 
        Height="700" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">
    
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="30,20">
            <StackPanel>
                <Viewbox Width="80" Height="80" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                        <!-- Lightning Bolt Icon -->
                        <Path Data="M7 2v11h3v9l7-12h-4l4-8z" 
                              Fill="Black" 
                              Stretch="Uniform" Canvas.Left="7" Canvas.Top="2"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Battery Swap System" 
                          FontSize="26" FontWeight="Bold"
                          Foreground="Black"
                          HorizontalAlignment="Center" 
                          Margin="0,15,0,0"/>
                <TextBlock Text="Eco-Friendly Energy Solution" 
                          FontSize="13" 
                          Foreground="Black"
                          HorizontalAlignment="Center" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Login Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="40,30">
            
            <TextBlock Text="Welcome Back!" 
                      FontSize="24" FontWeight="Bold"
                      Foreground="{DynamicResource PrimaryHueMidBrush}"
                      Margin="0,0,0,5"/>
            
            <TextBlock Text="Sign in to continue" 
                      FontSize="14" 
                      Foreground="Gray"
                      Margin="0,0,0,30"/>

            <!-- Email -->
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="Email Address"
                    materialDesign:HintAssist.FloatingScale="0.75"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    FontSize="14"
                    Margin="0,10"/>

            <!-- Password -->
            <PasswordBox x:Name="PasswordBox"
                        materialDesign:HintAssist.Hint="Password"
                        materialDesign:HintAssist.FloatingScale="0.75"
                        Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                        FontSize="14"
                        Margin="0,15"
                        PasswordChanged="PasswordBox_PasswordChanged"/>

            <!-- Error Message -->
            <Border Background="#FFEBEE" 
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,5"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircle" 
                                            Foreground="#C62828"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" 
                              Foreground="#C62828"
                              TextWrapping="Wrap"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Login Button -->
            <Button Content="LOGIN" 
                   Command="{Binding LoginCommand}"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Height="48"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,25,0,0"
                   IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
                <Button.Effect>
                    <DropShadowEffect Color="{DynamicResource Primary}" 
                                     Opacity="0.3" 
                                     BlurRadius="10" 
                                     ShadowDepth="2"/>
                </Button.Effect>
            </Button>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,15"/>

        </StackPanel>
    </Grid>
</Window>
